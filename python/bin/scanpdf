#!/bin/bash
# scanpdf — 命令行 / 监视文件夹入口（Python 参考引擎）。
# 这是 macOS / iOS App 之外的「参考实现」：同样的算法与质量闸门，但需要本机 Python 环境。
#
#   scanpdf in.pdf [more.pdf ...]
#   scanpdf --check            自检运行环境
#
# 依赖（任选其一安装）：
#   pip install pymupdf numpy pillow scipy
# 可用环境变量覆盖解释器：SCANPDF_PY=/path/to/python3
#
# 输出落到源文件同目录的 "<名字>-清晰版.pdf"；
# 若该目录不可写（如微信沙盒）则回退到 $BASE/已处理。

set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOLS="$(cd "$SCRIPT_DIR/.." && pwd)"
PY="${SCANPDF_PY:-python3}"
BASE="$HOME/Documents/扫描件清晰化"
PROCESSED="$BASE/已处理"
LOGDIR="$BASE/日志"

# 非 UTF-8 区域会让 Python 用 surrogateescape 解码中文文件名，进而破坏 PDF 元数据。
# 无论谁启动都先钉死区域设置。
export LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 PYTHONUTF8=1 PYTHONIOENCODING=utf-8

mkdir -p "$PROCESSED" "$LOGDIR" 2>/dev/null

die() { echo "错误：$*" >&2; exit 1; }

[ -x "$PY" ] || die "找不到 Python：$PY"
"$PY" -c "import pymupdf, numpy, PIL, scipy" 2>/dev/null || \
  die "处理环境缺依赖，请先：pip install pymupdf numpy pillow scipy"

if [ "${1:-}" = "--check" ]; then
  echo "python      $("$PY" -V 2>&1)"
  echo "libraries   $("$PY" -c 'import pymupdf,numpy,PIL,scipy;print("pymupdf",pymupdf.VersionBind,"| numpy",numpy.__version__,"| pillow",PIL.__version__,"| scipy",scipy.__version__)')"
  echo "engine      $TOOLS/scanpdf/engine.py"
  echo "watched in  $BASE/待处理"
  echo "watched out $PROCESSED"
  echo "log         $LOGDIR/scanpdf.log"
  exit 0
fi

[ $# -ge 1 ] || die "用法：scanpdf 文件.pdf [更多.pdf]  或  scanpdf --check"

STATUS=0
for SRC in "$@"; do
  [ -f "$SRC" ] || { echo "跳过（不是文件）：$SRC" >&2; STATUS=1; continue; }
  case "$SRC" in
    *-清晰版.pdf) echo "跳过（已经是清晰版）：$(basename "$SRC")" >&2; continue ;;
  esac
  NAME="$(basename "$SRC" .pdf)"
  OUT="$PROCESSED/$NAME-清晰版.pdf"

  echo "处理：$SRC"
  TS="$(date '+%Y-%m-%d %H:%M:%S')"
  if ! "$PY" "$TOOLS/scanpdf/engine.py" "$SRC" -o "$OUT" --json > "$LOGDIR/last.json" 2>"$LOGDIR/last.err"; then
    echo "失败：$(tail -c 400 "$LOGDIR/last.err" | tr '\n' ' ')" >&2
    echo "[$TS] FAIL $SRC" >> "$LOGDIR/scanpdf.log"
    STATUS=1
    continue
  fi

  if [ ! -f "$OUT" ]; then
    echo "未产出文件（可能是矢量 PDF，无需处理）" >&2
    "$PY" -c "import json;print('  ', json.load(open('$LOGDIR/last.json')).get('detail',''))" 2>/dev/null
    echo "[$TS] SKIP $SRC" >> "$LOGDIR/scanpdf.log"
    continue
  fi

  if "$PY" "$TOOLS/scanpdf/verify.py" "$SRC" "$OUT" > "$LOGDIR/last_verify.json" 2>&1; then
    GATE="通过"
    echo "[$TS] OK $SRC -> $OUT" >> "$LOGDIR/scanpdf.log"
  else
    GATE="未通过（见 $LOGDIR/last_verify.json）"
    STATUS=1
    echo "[$TS] VERIFY-FAIL $SRC -> $OUT" >> "$LOGDIR/scanpdf.log"
  fi

  "$PY" - "$OUT" "$LOGDIR/last.json" "$GATE" <<'PY'
import json, sys
d = json.load(open(sys.argv[2]))
dec = d["decisions"]
tags = []
if dec["geometry_bad"]: tags.append("页面尺寸异常已修正")
if dec["has_frame"]: tags.append("已去除扫描黑框")
if dec["notes_canvas"]: tags.append("已裁除备忘录白边")
if d["upscale_factor"] != 1.0: tags.append(f"已重采样 x{d['upscale_factor']}")
print("  判断：" + "、".join(tags or ["常规扫描"]))
print(f"  结果：{d['pages']} 页 A4，纸面宽 {d['sheet_width_mm']} mm，"
      f"有效 {d['per_page'][0]['dpi']} DPI，输出 {d['output_bytes'] / 1e6:.1f} MB，"
      f"用时 {d['seconds']}s，质量闸门{sys.argv[3]}")
print(f"  输出：{sys.argv[1]}")
PY
done

exit $STATUS
